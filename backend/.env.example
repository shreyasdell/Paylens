# Application Settings
APP_NAME=PayLens API
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://paylens:paylens@localhost:5432/paylens

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PERSIST_DIRECTORY=./data/chromadb

# Ollama Configuration
OLLAMA_BASE_URL=http://10.88.0.3:11434
OLLAMA_MODEL=phi3:latest

# LangChain Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=paylens

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=90.0
MEDIUM_CONFIDENCE_THRESHOLD=70.0

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200